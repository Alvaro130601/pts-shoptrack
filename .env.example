# Fuente de datos: "seed" (simulados), "zoho" (en vivo) o "excel" (exportación de tareas de Zoho a .xlsx)
DATA_SOURCE=seed
# Con DATA_SOURCE=excel: carpeta (se usa el .xlsx más reciente) o archivo. Por defecto data/exportaciones
# EXPORT_PATH=
PORT=8787
# Cada cuántos segundos el backend vuelve a leer Zoho (la web refresca cada 60 s)
ZOHO_REFRESH_SECONDS=300

# --- Asistente (docs/ASISTENTE.md) ---
# Clave de la API de Claude (https://console.anthropic.com). Sin ella, el asistente avisa y lo demás funciona.
ANTHROPIC_API_KEY=
# Opcionales: modelo y esfuerzo (low responde rápido; medium si se equivoca de operación)
# ASISTENTE_MODELO=claude-opus-5-5
# ASISTENTE_ESFUERZO=low

# --- Zoho Projects (Self Client en https://api-console.zoho.com) ---
# Scopes mínimos: ZohoProjects.portals.READ,ZohoProjects.projects.READ,ZohoProjects.tasks.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Data center de la cuenta (.com, .eu, .in...). PTS usa la cuenta de ptsportal388.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_PROJECTS_API=https://projectsapi.zoho.com
ZOHO_PORTAL_ID=714664835
