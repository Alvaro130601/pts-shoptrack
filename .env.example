# Fuente de datos: "seed" (simulados, no requiere Zoho) o "zoho" (en vivo)
DATA_SOURCE=seed
PORT=8787
# Cada cuántos segundos el backend vuelve a leer Zoho (la web refresca cada 60 s)
ZOHO_REFRESH_SECONDS=300

# --- Zoho Projects (Self Client en https://api-console.zoho.com) ---
# Scopes mínimos: ZohoProjects.portals.READ,ZohoProjects.projects.READ,ZohoProjects.tasks.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Data center de la cuenta (.com, .eu, .in...). PTS usa la cuenta de ptsportal388.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_PROJECTS_API=https://projectsapi.zoho.com
ZOHO_PORTAL_ID=714664835
